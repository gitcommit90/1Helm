# Copy to /etc/cloudflared/config-1helm-site.yml after creating a dedicated
# named tunnel. Keep the generated credentials file host-local at
# /etc/cloudflared/1helm-site-tunnel.json with mode 0600. The systemd unit
# exposes it read-only to an unprivileged dynamic user through LoadCredential.
tunnel: REPLACE_WITH_DEDICATED_TUNNEL_UUID
ingress:
  - hostname: 1helm.com
    service: http://127.0.0.1:8130
  - hostname: www.1helm.com
    service: http://127.0.0.1:8130
  - service: http_status:404
