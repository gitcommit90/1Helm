{
 // Hosted MCP servers for design sources. Public data only, so these endpoints need no sign-in.
 // Deploy: cd design-mcp; wrangler deploy -c wrangler.example.jsonc
 // Secret: BETTER_DESIGN_KEY (a free Better Design key, forwarded by /better-design/mcp and used by /brief/mcp; /inspo/mcp needs no key): wrangler secret put BETTER_DESIGN_KEY -c wrangler.example.jsonc
 // Endpoints: /magicui /reactbits /canvasui /better-design /inspo (all under /<name>/mcp) and /brief/mcp (tool design_brief).
 // Add a routes entry for your own domain if you want one. Nothing calls this Worker until the admin sets DESIGN_MCP_URL (for example to its address, or to https://mcp.1helm.com) as a variable of the main Worker, which turns on the design brief, and in the environment of the design_mcp.py client. Unset or empty means no calls.
 "name": "design-mcp",
 "main": "src/index.js",
 "compatibility_date": "2026-09-01",
 "workers_dev": true
}
