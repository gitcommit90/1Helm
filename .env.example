# Optional shell defaults for npm run setup. Copy to .env and export the values in your shell.
# This file is not a Worker secret store; deployed bindings are in wrangler.jsonc.
ONEHELM_WORKER_NAME=onehelm-personal
ONEHELM_APP_HOST=onehelm-personal.your-subdomain.workers.dev
ONEHELM_EMAIL_FROM=you@your-domain.example
ONEHELM_SUPPORT_EMAIL=you@your-domain.example
CLOUDFLARE_ACCOUNT_ID=your-32-character-account-id
