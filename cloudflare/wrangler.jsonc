{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1helm-workspace-provisioner",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-22",
  "routes": [
    { "pattern": "provision.1helm.com", "custom_domain": true }
  ],
  "ratelimits": [
    {
      "name": "PROVISION_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "REGISTRY",
      "database_name": "1helm-workspaces",
      "database_id": "a5cca2b1-06d2-4ac1-ac74-59a0ef2f9681",
      "migrations_dir": "migrations"
    }
  ]
}
