+
+/// 1Helm addition (sidecar prep): a PDF's Markdown page by page, so the
+/// sidecar keeps page markers. Returns `{ pageCount, pages: [{ page (1-based),
+/// markdown, needsOcr }], needsOcr: [1-based pages] }`. Local only: no OCR,
+/// no network.
+#[wasm_bindgen(js_name = pdfPages)]
+pub fn pdf_pages(bytes: &[u8]) -> Result<JsValue, JsValue> {
+    let r = pdf_inspector::extract_pages_markdown_mem(bytes, None).map_err(|e| {
+        let thrown = js_sys::Error::new(&e.to_string());
+        let code = match e { pdf_inspector::PdfError::Encrypted => "encrypted", _ => "malformed" };
+        let _ = js_sys::Reflect::set(&thrown, &JsValue::from_str("code"), &JsValue::from_str(code));
+        JsValue::from(thrown)
+    })?;
+    let out = js_sys::Object::new();
+    let pages = js_sys::Array::new();
+    for p in &r.pages {
+        let o = js_sys::Object::new();
+        let _ = js_sys::Reflect::set(&o, &"page".into(), &JsValue::from(p.page + 1));
+        let _ = js_sys::Reflect::set(&o, &"markdown".into(), &JsValue::from_str(&p.markdown));
+        let _ = js_sys::Reflect::set(&o, &"needsOcr".into(), &JsValue::from(p.needs_ocr));
+        pages.push(&o);
+    }
+    let _ = js_sys::Reflect::set(&out, &"pageCount".into(), &JsValue::from(r.pages.len() as u32));
+    let _ = js_sys::Reflect::set(&out, &"pages".into(), &pages);
+    let _ = js_sys::Reflect::set(&out, &"needsOcr".into(), &r.pages_needing_ocr.iter().map(|&p| JsValue::from(p)).collect::<js_sys::Array>());
+    Ok(out.into())
+}
